# Copie este arquivo para ".env" e preencha. NUNCA suba o ".env" no GitHub
# e nunca mande o token por WhatsApp. O token e so seu.

# Token PERMANENTE de Usuario do Sistema (Business Settings da Meta).
# Permissao minima para o painel: ads_read
META_ADS_TOKEN=COLE_AQUI_O_SEU_TOKEN

# Sua conta de anuncio. Formato: act_XXXXXXXXXX
META_AD_ACCOUNT=act_000000000000

# ID da campanha que o painel acompanha (use "python atualizar_painel.py --campanhas" para listar).
META_CAMPANHA_ID=

# Nome que aparece no topo do painel.
PAINEL_NOME=Minha campanha

# Custo-alvo por conversa em reais (a meta a bater). Deixe vazio para ocultar.
CUSTO_ALVO_CONVERSA=

# Acao que conta como "conversa/lead". Padrao: conversa iniciada no WhatsApp/Messenger.
# Para campanha de formulario use: lead
META_ACAO_CONVERSA=onsite_conversion.messaging_conversation_started_7d
